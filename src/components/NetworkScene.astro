---
const labels=[['Domain controller','DC01 · Identity authority'],['Workstation','WS01 · Initial foothold'],['Service account','SVC_WEB · Service identity'],['Certificate authority','CA01 · Certificate services'],['Domain user','STUDENT · Domain identity']];
---
<div class="network-scene" data-network-scene><div class="scene-topbar"><span class="mono"><i class="live-dot"></i> HEXFIELD.LOCAL</span><span class="mono">INTERACTIVE TOPOLOGY</span></div><div class="network-stage"><svg class="network-fallback" viewBox="0 0 640 400" aria-label="Domain topology connecting five identity and machine nodes" role="img"><path d="M330 85 140 230 350 280 510 160 330 85M140 230 130 90 330 85M350 280 330 85"/><g><rect x="298" y="47" width="64" height="72" rx="9"/><rect x="109" y="202" width="62" height="48" rx="6"/><circle cx="350" cy="280" r="25"/><path d="m510 125 28 35-28 35-28-35z"/><circle cx="130" cy="90" r="23"/></g><text x="330" y="145">DC01</text><text x="140" y="276">WS01</text><text x="350" y="328">SVC_WEB</text><text x="510" y="220">CA01</text><text x="130" y="136">STUDENT</text></svg><canvas aria-label="Interactive 3D Active Directory topology"></canvas><div class="scene-node-label" data-scene-label>DC01 · Identity authority</div><span class="scene-coordinate mono">LAB VISUALIZATION / 05 NODES</span></div><div class="scene-selector" role="group" aria-label="Inspect a topology node">{labels.map(([name,label],i)=><button data-scene-node={i} data-label={label} aria-label={name} aria-pressed={i===0?'true':'false'} class:list={i===0&&'active'}>{label.split(' · ')[0]}</button>)}</div><div class="scene-bottom"><span data-scene-status>Topology preview</span><span>SELECT A NODE TO INSPECT ↗</span></div></div>
<script>
const host=document.querySelector<HTMLElement>('[data-network-scene]');
if(host){const reduced=matchMedia('(prefers-reduced-motion: reduce)');let cleanup:undefined|(()=>void),loading=false,ended=false,paused=false;const motion=document.createElement('button');motion.className='scene-motion';motion.textContent=reduced.matches?'Reduced motion':'Pause 3D';motion.setAttribute('aria-pressed',String(reduced.matches));host.querySelector('.scene-topbar')!.append(motion);const buttons=host.querySelectorAll<HTMLButtonElement>('[data-scene-node]');const choose=(button:HTMLButtonElement)=>{buttons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});host.querySelector('[data-scene-label]')!.textContent=button.dataset.label!};buttons.forEach(b=>b.addEventListener('click',()=>choose(b)));
 const load=async()=>{if(loading||cleanup||reduced.matches||paused||ended)return;loading=true;try{const {mountNetwork}=await import('../scripts/network-scene');if(!ended&&!reduced.matches&&!paused)cleanup=mountNetwork(host)}catch{host.querySelector('[data-scene-status]')!.textContent='Simplified topology'}finally{loading=false}};
 const observer=new IntersectionObserver(entries=>{if(entries[0].isIntersecting)load()},{rootMargin:'150px'});observer.observe(host);
 const stop=()=>{cleanup?.();cleanup=undefined;host.classList.remove('webgl-ready')};motion.addEventListener('click',()=>{if(reduced.matches)return;paused=!paused;motion.textContent=paused?'Enable 3D':'Pause 3D';motion.setAttribute('aria-pressed',String(paused));if(paused)stop();else load()});reduced.addEventListener('change',()=>{motion.textContent=reduced.matches?'Reduced motion':paused?'Enable 3D':'Pause 3D';motion.setAttribute('aria-pressed',String(reduced.matches||paused));if(reduced.matches)stop();else load()});window.addEventListener('pagehide',()=>{ended=true;stop();observer.disconnect()});window.addEventListener('pageshow',()=>{ended=false;observer.observe(host)});
}
</script>
