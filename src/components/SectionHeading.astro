---
const { kicker, title, href, link = 'Explore all' } = Astro.props;
const heading=title.replace(/\.$/,'');
---
<div class="section-heading product-heading"><div><div class="section-kicker">{kicker}</div><h2>{heading}<span class="title-stop">.</span></h2></div>{href && <a class="text-link" href={href}>{link} <span aria-hidden="true">↗</span></a>}</div>
