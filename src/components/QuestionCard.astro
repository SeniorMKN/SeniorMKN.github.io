---
import Icon from './Icon.astro';
const { question:q, index=0 }=Astro.props;
---
<article class="question-card" data-question={q.id}><div class="question-index"><span class="mono">QUESTION / {String(index+1).padStart(2,'0')}</span><span class="access-badge">FREE</span></div><h2>{q.question}</h2><details class="answer-reveal"><summary><span class="show-label">Show answer</span><span class="hide-label">Hide answer</span><span aria-hidden="true">+</span></summary><div class="answer-body"><span class="section-kicker">THE SHORT ANSWER</span><p class="short-answer">{q.answer}</p><details class="deep-dive"><summary>Go deeper <span>↗</span></summary><p>{q.deeper}</p><div class="example-box"><span class="mono">EXAMPLE</span><p>{q.example}</p></div></details><div class="question-followups"><span class="mono">EXPECT A FOLLOW UP</span><ul>{q.followups.map((f:string)=><li>{f}</li>)}</ul></div><div class="key-point"><Icon name="key" size={18}/><p>{q.key}</p></div></div></details><div class="question-actions" role="group" aria-label="Save question status"><button data-mark="learned" aria-pressed="false"><Icon name="check" size={16}/>Learned</button><button data-mark="difficult" aria-pressed="false"><Icon name="bolt" size={16}/>Revisit</button><button data-mark="favorites" aria-pressed="false"><Icon name="star" size={16}/>Favorite</button></div></article>
