---
import { questions, categories } from '../data/academy';
---
<section class="progress-panel" data-progress-panel data-total={questions.length}><div class="progress-title"><span class="live-dot"></span><strong>Your workspace</strong><span class="local-label">SAVED ON THIS DEVICE</span></div><div class="progress-metrics"><div><strong data-reviewed>0<span>/{questions.length}</span></strong><span>Questions reviewed</span></div><div><strong data-learned>0</strong><span>Marked learned</span></div><div><strong data-topics>0<span>/{categories.length}</span></strong><span>Categories complete</span></div><div><strong data-streak>0<span> days</span></strong><span>Study streak</span></div></div><div class="progress-track"><span data-overall-fill></span></div><div class="progress-note"><span data-progress-message>Open a question to start your learning record.</span><span>Labs · in development</span></div><noscript><p>Enable JavaScript for local progress tracking.</p></noscript></section>
