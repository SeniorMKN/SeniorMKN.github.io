---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NetworkScene from '../components/NetworkScene.astro';
import LabCard from '../components/LabCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProgressPanel from '../components/ProgressPanel.astro';
import AttackGraph from '../components/AttackGraph.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { labs,categories } from '../data/academy';
const notes=(await getCollection('notes')).sort((a,b)=>a.data.order-b.data.order);
---
<Base>
 <section class="product-hero wrap"><div class="product-hero-copy"><div class="eyebrow"><span class="live-dot"></span> OFFENSIVE SECURITY / CONNECTED LEARNING</div><h1>Learn.<br/>Break.<br/><em>Understand.</em></h1><p>Map the system. Trace the path.<br/>Build the skill to explain what happens next.</p><div class="hero-actions"><a class="button button-primary" href="/academy/ad-sets/">Explore labs <Icon name="arrow" size={17}/></a><a class="text-link" href="/academy/interview-notes/">Interview prep <span>↗</span></a></div><div class="hero-proof"><span><i></i> AD LAB BLUEPRINTS</span><span><i></i> FREE STUDY MODULES</span></div></div><NetworkScene/></section>
 <div class="capability-strip"><div class="wrap"><span><Icon name="network"/>Active Directory</span><span><Icon name="target"/>Pentest methodology</span><span><Icon name="terminal"/>Technical interviews</span><span><Icon name="book"/>Field notes</span></div></div>
 <div class="wrap home-progress"><ProgressPanel/></div>
 <section class="section wrap"><SectionHeading kicker="01 / THE LAB BENCH" title="Enter the environment" href="/academy/ad-sets/" link="All lab blueprints"/><div class="lab-grid">{labs.map((lab,index)=><LabCard lab={lab} index={index}/>)}</div><p class="section-caption">Lab environments are in development. *Host counts and study times are design targets.</p></section>
 <section class="section wrap"><SectionHeading kicker="02 / THINK IN RELATIONSHIPS" title="Trace the attack path"/><AttackGraph/></section>
 <section class="section wrap"><SectionHeading kicker="03 / THE INTERVIEW ROOM" title="Know it. Explain it." href="/academy/interview-notes/" link="Open question bank"/><div class="category-grid">{categories.map(category=><CategoryCard category={category}/>)}</div></section>
 <section class="section wrap field-section"><SectionHeading kicker="04 / OPEN FIELD NOTES" title="Build your mental model" href="/notes/" link="Browse the library"/><div class="field-grid">{notes.map((note,i)=><a class="field-tile" href={`/notes/${note.id}/`}><span class="field-number">0{i+1}</span><div><span class="mono">{note.data.track} / FREE</span><h3>{note.data.title}</h3><span class="field-reading">{note.data.readingTime}</span></div><Icon name="arrow" size={19}/></a>)}</div></section>
 <section class="pro-banner wrap"><span class="pro-seal"><Icon name="lock" size={26}/></span><div><span class="access-badge pro">PRO / IN DEVELOPMENT</span><h2>Deeper environments. Sharper thinking.</h2><p>Advanced lab sets and focused study packs are on the roadmap.</p></div><a class="text-link" href="/academy/ad-sets/">Preview the direction <span>↗</span></a></section>
</Base>
