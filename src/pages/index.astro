---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import NoteCard from '../components/NoteCard.astro';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span> AN OPEN FIELD GUIDE TO SECURITY</div>
      <h1>See the<br /><em>whole</em> system<span class="title-stop">.</span></h1>
      <p class="hero-lead">Clear mental models for the systems behind offensive security. Start with the fundamentals. Follow the connections. Build real understanding.</p>
      <div class="hero-actions"><a class="button button-primary" href="/roadmap/">Follow the roadmap <span aria-hidden="true">↗</span></a><a class="text-link" href="/notes/">Browse all notes <span aria-hidden="true">→</span></a></div>
      <div class="hero-meta"><span><strong>02</strong> LEARNING TRACKS</span><span class="meta-rule"></span><span><strong>04</strong> FIELD NOTES</span><span class="meta-rule"></span><span>BUILT FOR THE CURIOUS</span></div>
    </div>
    <HeroScene />
  </section>
  <section class="signal-strip"><div class="wrap signal-inner"><span>01 / LEARN THE SYSTEM</span><span class="strip-line"></span><span>02 / CONNECT THE DOTS</span><span class="strip-line"></span><span>03 / PRACTICE RESPONSIBLY</span></div></section>
  <section class="section wrap tracks-section" id="tracks">
    <div class="section-heading"><div><div class="section-kicker">THE MAP / 01</div><h2>Choose a starting point<span class="title-stop">.</span></h2></div><p>Two foundational tracks. One goal: understand what is happening beneath the surface.</p></div>
    <div class="track-grid">
      <a href="/roadmap/#active-directory" class="track-card ad-track"><div class="track-card-top"><span>TRACK / 01</span><span aria-hidden="true">↗</span></div><div class="track-symbol" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div><div><span class="track-small">IDENTITY · TRUST · AUTHENTICATION</span><h3>Active<br />Directory</h3><p>Understand the directory, the domain, and the identity protocols that hold an enterprise together.</p><span class="track-count">02 FIELD NOTES <span aria-hidden="true">→</span></span></div></a>
      <a href="/roadmap/#linux" class="track-card linux-track"><div class="track-card-top"><span>TRACK / 02</span><span aria-hidden="true">↗</span></div><div class="linux-glyph" aria-hidden="true">$_<span class="glyph-cursor"></span></div><div><span class="track-small">IDENTITY · PROCESSES · OBSERVABILITY</span><h3>Linux<br />Environment</h3><p>Read a Linux system through its users, permissions, running processes, and logs.</p><span class="track-count">02 FIELD NOTES <span aria-hidden="true">→</span></span></div></a>
    </div>
  </section>
  <section class="section wrap notes-section"><div class="section-heading"><div><div class="section-kicker">THE LIBRARY / 02</div><h2>Latest field notes<span class="title-stop">.</span></h2></div><a class="text-link" href="/notes/">View all notes <span aria-hidden="true">↗</span></a></div><div class="notes-grid">{notes.map((note, index) => <NoteCard note={note} index={index} />)}</div></section>
  <section class="manifesto wrap"><div class="manifesto-index">THE HEXFIELD METHOD <span>↘</span></div><p>Tools change. <em>Mental models</em> stay useful.</p><div class="manifesto-bottom"><span>Explore the structure behind the symptoms.</span><a href="/about/">Why this exists ↗</a></div></section>
</Base>
