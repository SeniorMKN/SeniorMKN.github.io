---
import Base from '../../layouts/Base.astro';
import ProgressPanel from '../../components/ProgressPanel.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import { categories } from '../../data/academy';
---
<Base title="Your workspace — Hexfield"><section class="workspace-header wrap"><div><div class="eyebrow"><span class="live-dot"></span> YOUR LEARNING WORKSPACE</div><h1>Pick up the thread<span>.</span></h1><p>Study, practice, and keep a record of what clicks.</p></div><span class="workspace-emblem" aria-hidden="true">✳</span></section><div class="wrap"><ProgressPanel/></div><section class="section wrap"><div class="workspace-routes"><a href="/academy/ad-sets/"><Icon name="network" size={30}/><span class="mono">THE LAB BENCH</span><h2>AD Set Labs</h2><p>Three environment blueprints. Built around connected systems.</p><span class="route-bottom">IN DEVELOPMENT <b>↗</b></span></a><a href="/academy/interview-notes/"><Icon name="terminal" size={30}/><span class="mono">THE INTERVIEW ROOM</span><h2>Interview prep</h2><p>12 questions. Reveal, explain, and track your understanding.</p><span class="route-bottom">START LEARNING <b>↗</b></span></a></div></section><section class="section wrap field-section"><SectionHeading kicker="YOUR STUDY MODULES" title="Choose a focus"/><div class="category-grid">{categories.map(category=><CategoryCard category={category}/>)}</div></section></Base>
