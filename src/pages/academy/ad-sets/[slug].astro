---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { labs } from '../../../data/academy';
export function getStaticPaths(){return labs.map(lab=>({params:{slug:lab.slug},props:{lab}}))}
const {lab}=Astro.props;
---
<Base title={`${lab.name} — AD Set Labs · Hexfield`}><div class="wrap detail-breadcrumb"><a href="/academy/ad-sets/">← ALL LABS</a><span>ENVIRONMENT BLUEPRINT</span></div><section class="lab-detail wrap"><div><span class:list={['access-badge',lab.tier==='PRO'&&'pro']}>{lab.tier} · PLANNED</span><h1>{lab.name}<span>.</span></h1><p>{lab.objective}</p><div class="techniques">{lab.techniques.map((t:string)=><span>{t}</span>)}</div><div class="spec-grid"><div><span>DIFFICULTY</span><strong>{lab.level}</strong></div><div><span>TARGET HOSTS</span><strong>{lab.machines}</strong></div><div><span>TARGET STUDY TIME</span><strong>{lab.time}</strong></div><div><span>PLATFORM</span><strong>Windows / AD</strong></div></div><span class="section-caption">Planned specifications. Final topology and OS versions are not yet published.</span></div><div class="locked-environment"><Icon name="lock" size={33}/><span class="mono">ENVIRONMENT / OFFLINE</span><div class="host-row">{lab.nodes.map((node:string)=><span><Icon name="server"/>{node}</span>)}</div><h2>Lab in development</h2><p>This is a blueprint preview.<br/>No machines or downloads are available yet.</p><a class="button button-primary" href="/roadmap/#active-directory">Build the foundations <Icon name="arrow" size={16}/></a></div></section><section class="wrap objectives-section"><div class="section-kicker">PLANNED LEARNING OBJECTIVES</div>{lab.milestones.map((m:string,i:number)=><div class="objective-row"><span>0{i+1}</span><h2>{m}</h2><Icon name="target"/></div>)}</section></Base>
