---
import Base from '../../../layouts/Base.astro';
import LabCard from '../../../components/LabCard.astro';
import AttackGraph from '../../../components/AttackGraph.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { labs } from '../../../data/academy';
---
<Base title="AD Set Labs — Hexfield"><section class="catalog-hero wrap"><div class="eyebrow"><span class="live-dot"></span> THE LAB BENCH / OSCP-STYLE PRACTICE</div><h1>One domain.<br/><em>Multiple ways in.</em></h1><p>Connected Active Directory environments. Every relationship matters.</p><div class="catalog-summary"><span>03 BLUEPRINTS</span><span>FOUNDATION → ADVANCED</span><span class="status-chip">IN DEVELOPMENT</span></div></section><section class="wrap catalog-body"><div class="catalog-controls"><span class="mono">ENVIRONMENT BLUEPRINTS</span><div class="filter-group" aria-label="Filter labs by difficulty" role="group">{['All','Foundation','Intermediate','Advanced'].map((l,i)=><button class:list={['filter-button',i===0&&'active']} data-lab-filter={l} aria-pressed={i===0?'true':'false'}>{l}</button>)}</div></div><div class="lab-grid">{labs.map((lab,index)=><div data-lab-level={lab.level}><LabCard lab={lab} index={index}/></div>)}</div><p class="section-caption">Lab access is not available yet. *Host counts and study times are planned specifications.</p><div class="lab-format"><span>01 <b>MAP</b> the environment</span><span>02 <b>VALIDATE</b> each relationship</span><span>03 <b>EXPLAIN</b> the impact</span></div></section><section class="section wrap field-section"><SectionHeading kicker="EXPLORE THE METHOD" title="A path is a chain of evidence"/><AttackGraph/><p class="section-caption">Independent learning material. Not affiliated with OffSec; no official exam content.</p></section><script>document.querySelectorAll<HTMLButtonElement>('[data-lab-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-lab-filter]').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b))});document.querySelectorAll<HTMLElement>('[data-lab-level]').forEach(x=>x.hidden=b.dataset.labFilter!=='All'&&x.dataset.labLevel!==b.dataset.labFilter)}));</script></Base>
