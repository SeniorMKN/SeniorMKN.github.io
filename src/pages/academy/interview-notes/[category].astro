---
import Base from '../../../layouts/Base.astro';
import QuestionCard from '../../../components/QuestionCard.astro';
import StudyReferences from '../../../components/StudyReferences.astro';
import Icon from '../../../components/Icon.astro';
import { categories,questions } from '../../../data/academy';
export function getStaticPaths(){return [...categories,{id:'practice',name:'Mixed practice',description:'A fresh perspective across the fundamentals.',icon:'target'}].map(category=>({params:{category:category.id},props:{category}}))}
const {category}=Astro.props;
const selected=category.id==='practice'?questions:questions.filter(q=>q.category===category.id);
---
<Base title={`${category.name} — Interview prep · Hexfield`}><div class="wrap detail-breadcrumb"><a href="/academy/interview-notes/">← ALL MODULES</a><span>INTERVIEW PREP / FREE</span></div><section class="question-page wrap" data-question-workspace><div class="question-page-header"><div class="icon-tile"><Icon name={category.icon} size={27}/></div><div><h1>{category.name}</h1><p>{category.description}</p></div><span class="mono" data-visible-count>{selected.length} questions</span></div><div class="question-toolbar"><div class="filter-group" role="group" aria-label="Filter questions"><button class="filter-button active" data-question-filter="all" aria-pressed="true">All questions</button><button class="filter-button" data-question-filter="difficult" aria-pressed="false">Revisit</button><button class="filter-button" data-question-filter="favorites" aria-pressed="false">Favorites</button></div><div class="practice-actions"><button class="subtle-button" data-random-question>Random ↝</button><button class="subtle-button" data-mock-start>Mock interview ▷</button></div></div><p class="session-message" data-session-message aria-live="polite"></p><div class="mock-bar" data-mock-bar hidden><span class="mono" data-mock-label></span><button data-mock-exit class="subtle-button">Exit</button><button data-mock-next class="button button-primary">Next question →</button></div><div class="question-grid">{selected.map((question,index)=><QuestionCard question={question} index={index}/>)}</div><div class="empty-state" data-empty-questions hidden><Icon name="book" size={32}/><h2>No questions in this view yet.</h2><p>Mark a question as Revisit or Favorite, or return to All questions.</p></div><p class="section-caption">Progress stays in this browser. “Learned” is your self-assessment. Mock interviews do not provide automated grading.</p><StudyReferences category={category.id}/><noscript><p>Answers remain readable without JavaScript. Enable it for filters, practice modes, and saved progress.</p></noscript></section><script>import '../../../scripts/questions';</script></Base>

