import CategoryCard from '../../../components/CategoryCard.astro';
import ProgressPanel from '../../../components/ProgressPanel.astro';
import Icon from '../../../components/Icon.astro';
import { categories } from '../../../data/academy';
---
<Base title="Interview prep — Hexfield"><section class="catalog-hero wrap"><div class="eyebrow"><span class="live-dot"></span> THE INTERVIEW ROOM</div><h1>Think clearly.<br/><em>Answer confidently.</em></h1><p>Reveal the answer. Explore the why. Make it stick.</p><div class="catalog-summary"><span>12 FREE QUESTIONS</span><span>06 STUDY MODULES</span><a class="button button-primary" href="/academy/interview-notes/practice/">Mixed practice <Icon name="arrow" size={16}/></a></div></section><div class="wrap"><ProgressPanel/></div><section class="section wrap field-section"><div class="category-grid">{categories.map(category=><CategoryCard category={category}/>)}</div><div class="interview-info"><span><Icon name="check"/>Mark what you know</span><span><Icon name="bolt"/>Revisit difficult questions</span><span><Icon name="star"/>Keep your favorites</span></div><div class="coming-pack"><Icon name="lock" size={22}/><div><span class="access-badge pro">PRO / IN DEVELOPMENT</span><h3>Deep-dive interview packs</h3><p>Expanded question sets and technical scenarios are planned.</p></div><span class="mono">NOT AVAILABLE YET</span></div></section></Base>
